<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shmyndra.Mavlink.V1\Shmyndra.Mavlink.V1.csproj" />
    <ProjectReference Include="..\Shmyndra.Mavlink.V2\Shmyndra.Mavlink.V2.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shmyndra.Mavlink.Generator\Shmyndra.Mavlink.Generator.csproj">
      <ReferenceOutputAssembly>False</ReferenceOutputAssembly>
      <OutputItemType>Analyzer</OutputItemType>
    </ProjectReference>
  </ItemGroup>
  
  <!-- DEBUG -->
  <PropertyGroup Condition="'$(BuildingInsideVisualStudio)' == 'true'">
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated/Analyzers</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <!-- DEBUG -->
  <ItemGroup Condition="'$(BuildingInsideVisualStudio)' == 'true'">
    <Compile Remove="$(CompilerGeneratedFilesOutputPath)/**" />
    <None Include="$(CompilerGeneratedFilesOutputPath)/**" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="**/*.xml" />
  </ItemGroup>
</Project>
