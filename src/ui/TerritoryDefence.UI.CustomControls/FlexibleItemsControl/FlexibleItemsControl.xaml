<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:local="using:TerritoryDefence.UI.CustomControls.FlexibleItemsControl"
					xmlns:ap="using:TerritoryDefence.UI.Toolkit.AttachedProperties">
	
	<Style TargetType="local:FlexibleItemsControl">
		<Setter Property="ItemsPanel">
			<Setter.Value>
				<ItemsPanelTemplate>
					<RelativePanel/>
				</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="RelativeModeTemplate">
			<Setter.Value>
				<DataTemplate>
					<Grid ColumnDefinitions="20,*,20" RowDefinitions="20,*,20">
						<ContentPresenter Grid.ColumnSpan="3" Grid.RowSpan="3"
										  ap:RelativeSourceBinding.AncestorType="local:FlexibleItemsControl"
										  ContentTemplate="{Binding Path=(ap:RelativeSourceBinding.Ancestor).ItemTemplate, RelativeSource={RelativeSource Self}}"/>
						<!-- Top -->
						<Rectangle Fill="Orange" RadiusX="4" RadiusY="4" Opacity="1" Grid.Column="1" Grid.Row="0" MaxWidth="60"/>
						<!-- Right -->
						<Rectangle Fill="Orange" RadiusX="4" RadiusY="4" Opacity="1" Grid.Column="2" Grid.Row="1" MaxHeight="60"/>
						<!-- Bottom -->
						<Rectangle Fill="Orange" RadiusX="4" RadiusY="4" Opacity="1" Grid.Column="1" Grid.Row="2" MaxWidth="60"/>
						<!-- Left -->
						<Rectangle Fill="Orange" RadiusX="4" RadiusY="4" Opacity="1" Grid.Column="0" Grid.Row="1" MaxHeight="60"/>
					</Grid>
				</DataTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
