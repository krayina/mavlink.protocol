<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:local="using:TerritoryDefence.UI.CustomControls.FlexibleItemsControl"
					xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls">

	<Style TargetType="local:FlexibleItemsControl">
		<!--<Setter Property="local:RelativeSourceBinding.AncestorType" Value="local:FlexibleItemsControl"/>-->
		<Setter Property="RelativeModeTemplate">
			<Setter.Value>
				<DataTemplate>
					<Grid Height="200" Width="200" Background="Red" 
						  ColumnDefinitions="20,*,20" RowDefinitions="20,*,20">

						<ContentPresenter Name="AAAAAAAAAAAAA" Grid.ColumnSpan="3" Grid.RowSpan="3" 
										  local:RelativeSourceBinding.AncestorType="local:FlexibleItemsControl"
										  ContentTemplate="{Binding Path=(local:RelativeSourceBinding.Ancestor).ItemTemplate, RelativeSource={RelativeSource Self}}">
							<!--<ContentPresenter.ContentTemplate>
								<DataTemplate>
									<TextBox Text="{Binding}" Background="Pink" Margin="5"/>
								</DataTemplate>
							</ContentPresenter.ContentTemplate>-->
						</ContentPresenter>
						<!-- Top -->
						<Rectangle Fill="Orange" RadiusX="4" RadiusY="4" Opacity="1" Grid.Column="1" Grid.Row="0" MaxWidth="60"/>
						<!-- Right -->
						<Rectangle Fill="Orange" RadiusX="4" RadiusY="4" Opacity="1" Grid.Column="2" Grid.Row="1" MaxHeight="60"/>
						<!-- Bottom -->
						<Rectangle Fill="Orange" RadiusX="4" RadiusY="4" Opacity="1" Grid.Column="1" Grid.Row="2" MaxWidth="60"/>
						<!-- Left -->
						<Rectangle Fill="Orange" RadiusX="4" RadiusY="4" Opacity="1" Grid.Column="0" Grid.Row="1" MaxHeight="60"/>
					</Grid>
				</DataTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
