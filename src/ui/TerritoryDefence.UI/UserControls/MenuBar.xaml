<UserControl x:Class="TerritoryDefence.UI.UserControls.MenuBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:ui="using:CommunityToolkit.WinUI.UI"
			 xmlns:i="using:Microsoft.Xaml.Interactivity"
			 xmlns:core="using:Microsoft.Xaml.Interactions.Core"
			 xmlns:behaviors="using:TerritoryDefence.UI.Toolkit.Behaviors">

	<ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" Margin="10">
		<StackPanel Orientation="Horizontal" CornerRadius="10"
				    Background="#fafcfe" BorderBrush="#dce0e4" BorderThickness="2">
			<Grid x:Name="AddNewGrid" ColumnDefinitions="70,Auto,20">
				<FlyoutBase.AttachedFlyout>
					<MenuFlyout>
						<MenuFlyoutItem Text="UDP"/>
						<MenuFlyoutItem Text="TCP"/>
					</MenuFlyout>
				</FlyoutBase.AttachedFlyout>
				<i:Interaction.Behaviors>
					<core:EventTriggerBehavior EventName="Tapped" SourceObject="{Binding ElementName=AddNewGrid}">
						<!--<behaviors:ShowAttachedFlyoutBehavior/>-->
					</core:EventTriggerBehavior>
				</i:Interaction.Behaviors>
				<Image Grid.Column="0" Stretch="Uniform"
					   HorizontalAlignment="Stretch"
					   Source="ms-appx:///TerritoryDefence.UI/Assets/Icons/new.svg"
					   ui:VisualExtensions.Scale="0.5,0.5,0"
					   ui:VisualExtensions.NormalizedCenterPoint="0.5,0.5"/>
				<TextBlock Grid.Column="1" Text="New" VerticalAlignment="Center"/>
			</Grid>
		</StackPanel>
	</ScrollViewer>
</UserControl>
