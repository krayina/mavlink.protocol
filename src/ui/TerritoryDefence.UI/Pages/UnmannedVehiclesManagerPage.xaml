<Page x:Class="TerritoryDefence.UI.Pages.UnmannedVehiclesManagerPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
      xmlns:maps="using:Mapsui.UI.WinUI"
      NavigationCacheMode="Required">

    <Grid RowDefinitions="100,*">
        <Border Grid.Row="0"/>

        <maps:MapControl x:Name="MapControl" Grid.Row="1" CornerRadius="20" BorderThickness="1" BorderBrush="#e2e6e9"
                         Width="200" Height="200" Margin="50"
                         HorizontalAlignment="Left" VerticalAlignment="Top"/>
    </Grid>
</Page>
